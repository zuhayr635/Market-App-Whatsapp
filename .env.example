# ── Veritabanı ────────────────────────────────────────────────────────────────
# docker-compose otomatik kullanır, değiştirme
DB_PASSWORD=guclu_bir_sifre_yaz

# ── Uygulama ──────────────────────────────────────────────────────────────────
# openssl rand -base64 32  komutu ile üret
NEXTAUTH_SECRET=buraya_32_karakterden_uzun_rastgele_bir_deger_yaz

# Sitenin tam adresi (sonunda / olmadan)
NEXTAUTH_URL=https://cihanekspress.com
NEXT_PUBLIC_BASE_URL=https://cihanekspress.com

# Uygulama portu (Coolify otomatik yönetir, 3000 bırak)
APP_PORT=3000

# ── E-posta (isteğe bağlı) ────────────────────────────────────────────────────
# Admin panelinden de ayarlanabilir
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=info@cihanekspress.com
# SMTP_PASS=uygulama_sifresi
# SMTP_FROM=noreply@cihanekspress.com
