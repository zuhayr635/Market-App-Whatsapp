generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== USER SYSTEM ====================

model User {
  id                String     @id @default(cuid())
  name              String
  surname           String
  email             String     @unique
  phone             String
  passwordHash      String
  cityId            Int?
  districtId        Int?
  address           String?    @db.Text
  securityQuestion  String?
  securityAnswer    String?
  emailVerified     DateTime?
  phoneVerified     DateTime?
  status            UserStatus @default(ACTIVE)
  role              UserRole   @default(MEMBER)
  failedLogins      Int        @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastLogin         DateTime?

  city       City?      @relation(fields: [cityId], references: [id])
  district   District?  @relation(fields: [districtId], references: [id])
  addresses  Address[]
  favorites  Favorite[]
  cart       Cart?
  orders     Order[]
  recentlyViewed RecentlyViewed[]

  @@index([status])
  @@index([role])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum UserRole {
  MEMBER
  ADMIN
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  title       String
  cityId      Int
  districtId  Int
  fullAddress String  @db.Text
  isDefault   Boolean @default(false)
  status      Boolean @default(true)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City     @relation(fields: [cityId], references: [id])
  district District @relation(fields: [districtId], references: [id])

  @@map("addresses")
}

// ==================== LOCATION ====================

model City {
  id        Int        @id @default(autoincrement())
  name      String
  plateCode String
  sortOrder Int        @default(0)
  status    Boolean    @default(true)

  districts District[]
  users     User[]
  addresses Address[]

  @@map("cities")
}

model District {
  id        Int     @id @default(autoincrement())
  cityId    Int
  name      String
  sortOrder Int     @default(0)
  status    Boolean @default(true)

  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  users     User[]
  addresses Address[]

  @@map("districts")
}

// ==================== ADMIN ====================

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  surname      String
  email        String    @unique
  passwordHash String
  role         String    @default("admin")
  status       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs AdminLog[]

  @@map("admin_users")
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  detail    String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([createdAt])
  @@map("admin_logs")
}

// ==================== PRODUCTS ====================

model Brand {
  id     String  @id @default(cuid())
  name   String
  logo   String?
  slug   String  @unique
  status Boolean @default(true)

  products Product[]

  @@map("brands")
}

model Category {
  id          String  @id @default(cuid())
  parentId    String?
  name        String
  description String? @db.Text
  image       String?
  slug        String  @unique
  seoTitle    String?
  seoDesc     String? @db.Text
  sortOrder   Int     @default(0)
  status      Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  shortDesc       String?  @db.Text
  fullDesc        String?  @db.LongText
  sku             String   @unique
  barcode         String?
  brandId         String?
  manufacturer    String?
  originCountry   String?
  priceUsd        Decimal  @db.Decimal(10, 2)
  priceTl         Decimal  @db.Decimal(10, 2)
  salePriceUsd    Decimal? @db.Decimal(10, 2)
  salePriceTl     Decimal? @db.Decimal(10, 2)
  saleStart       DateTime?
  saleEnd         DateTime?
  vatRate         Int      @default(18)
  vatIncluded     Boolean  @default(true)
  stockTracking   Boolean  @default(true)
  stockQty        Int      @default(0)
  lowStockThreshold Int    @default(5)
  weight          Decimal? @db.Decimal(8, 2)
  width           Decimal? @db.Decimal(8, 2)
  height          Decimal? @db.Decimal(8, 2)
  depth           Decimal? @db.Decimal(8, 2)
  isFeatured      Boolean  @default(false)
  isNew           Boolean  @default(false)
  isBestSeller    Boolean  @default(false)
  seoTitle        String?
  seoDesc         String?  @db.Text
  status          ProductStatus @default(DRAFT)
  visibility      ProductVisibility @default(PUBLIC)
  publishAt       DateTime?
  sortOrder       Int      @default(0)
  viewCount       Int      @default(0)
  customCss       String?  @db.Text
  customJs        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand           Brand?   @relation(fields: [brandId], references: [id])
  categories      ProductCategory[]
  images          ProductImage[]
  videos          ProductVideo[]
  files           ProductFile[]
  links           ProductLink[]
  attributes      ProductAttribute[]
  tabs            ProductTab[]
  tags            ProductTag[]
  variations      ProductVariation[]
  relatedFrom     RelatedProduct[] @relation("RelatedFrom")
  relatedTo       RelatedProduct[] @relation("RelatedTo")
  favorites       Favorite[]
  cartItems       CartItem[]
  recentlyViewed  RecentlyViewed[]
  stockAlerts     StockAlert[]

  @@index([status])
  @@index([status, isFeatured])
  @@index([status, isNew])
  @@index([status, isBestSeller])
  @@index([status, createdAt])
  @@index([status, sortOrder])
  @@index([brandId])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  PENDING
  HIDDEN
}

enum ProductVisibility {
  PUBLIC
  MEMBERS_ONLY
  PASSWORD_PROTECTED
}

model ProductCategory {
  id         String @id @default(cuid())
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_categories")
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  url         String
  altText     String?
  title       String?
  description String?
  sortOrder   Int     @default(0)
  isFeatured  Boolean @default(false)
  variationId String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVideo {
  id        String @id @default(cuid())
  productId String
  url       String
  type      String @default("youtube")
  thumbnail String?
  title     String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_videos")
}

model ProductFile {
  id            String  @id @default(cuid())
  productId     String
  url           String
  fileName      String
  fileSize      Int
  downloadable  Boolean @default(true)
  downloadCount Int     @default(0)
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_files")
}

model ProductLink {
  id        String  @id @default(cuid())
  productId String
  title     String
  url       String
  icon      String?
  newTab    Boolean @default(true)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_links")
}

model AttributeType {
  id     String  @id @default(cuid())
  name   String
  slug   String  @unique
  status Boolean @default(true)

  attributes ProductAttribute[]

  @@map("attribute_types")
}

model ProductAttribute {
  id              String  @id @default(cuid())
  productId       String
  attributeTypeId String
  value           String
  useForVariation Boolean @default(false)
  showInFilter    Boolean @default(false)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeType AttributeType @relation(fields: [attributeTypeId], references: [id])

  @@map("product_attributes")
}

model ProductTab {
  id        String  @id @default(cuid())
  productId String
  title     String
  content   String  @db.LongText
  icon      String?
  sortOrder Int     @default(0)
  status    Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_tabs")
}

model Tag {
  id     String  @id @default(cuid())
  name   String
  slug   String  @unique
  status Boolean @default(true)

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  id        String @id @default(cuid())
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@map("product_tags")
}

// ==================== VARIATIONS ====================

model VariationType {
  id          String @id @default(cuid())
  name        String
  displayType String @default("dropdown")
  sortOrder   Int    @default(0)
  status      Boolean @default(true)

  values VariationValue[]

  @@map("variation_types")
}

model VariationValue {
  id              String  @id @default(cuid())
  variationTypeId String
  value           String
  colorCode       String?
  image           String?
  sortOrder       Int     @default(0)
  status          Boolean @default(true)

  variationType VariationType @relation(fields: [variationTypeId], references: [id], onDelete: Cascade)

  @@map("variation_values")
}

model ProductVariation {
  id            String   @id @default(cuid())
  productId     String
  combination   Json
  sku           String?
  priceDiff     Decimal? @db.Decimal(10, 2)
  salePrice     Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0)
  weight        Decimal? @db.Decimal(8, 2)
  imageUrl      String?
  description   String?
  status        Boolean  @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variations")
}

model RelatedProduct {
  id        String @id @default(cuid())
  productId String
  relatedId String
  sortOrder Int    @default(0)

  product Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
  @@map("related_products")
}

// ==================== CART ====================

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id          String  @id @default(cuid())
  cartId      String
  productId   String
  variationId String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

// ==================== ORDERS ====================

model Order {
  id          String      @id @default(cuid())
  orderNo     String      @unique
  userId      String
  status      OrderStatus @default(PENDING)
  totalTl     Decimal     @db.Decimal(10, 2)
  totalUsd    Decimal     @db.Decimal(10, 2)
  addressJson Json?
  orderNote   String?     @db.Text
  adminNote   String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  couponCode      String?
  discountAmount  Decimal?    @db.Decimal(10, 2)

  user         User           @relation(fields: [userId], references: [id])
  items        OrderItem[]
  history      OrderHistory[]
  paymentLinks PaymentLink[]
  receipts     Receipt[]
  shipping     ShippingInfo?

  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  IBAN_SENT
  PAYMENT_WAITING
  RECEIPT_UPLOADED
  PAYMENT_CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  productName   String
  variationJson Json?
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2)
  totalPrice    Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model OrderHistory {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  description String?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_history")
}

// ==================== PAYMENT ====================

model PaymentLink {
  id          String   @id @default(cuid())
  orderId     String
  linkCode    String   @unique
  expiresAt   DateTime
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_links")
}

model Receipt {
  id          String        @id @default(cuid())
  orderId     String
  fileUrl     String
  payerName   String?
  paymentDate DateTime?
  amount      Decimal?      @db.Decimal(10, 2)
  note        String?       @db.Text
  status      ReceiptStatus @default(PENDING)
  rejectReason String?      @db.Text
  uploadedAt  DateTime      @default(now())
  reviewedAt  DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

model IbanInfo {
  id          String  @id @default(cuid())
  bankName    String
  bankLogo    String?
  iban        String
  accountHolder String
  branchCode  String?
  currency    String  @default("TRY")
  sortOrder   Int     @default(0)
  status      Boolean @default(true)

  @@map("iban_info")
}

// ==================== SHIPPING ====================

model ShippingCompany {
  id           String  @id @default(cuid())
  name         String
  logo         String?
  trackingUrl  String?
  status       Boolean @default(true)

  shipments ShippingInfo[]

  @@map("shipping_companies")
}

model ShippingInfo {
  id              String    @id @default(cuid())
  orderId         String    @unique
  companyId       String
  trackingNo      String
  estimatedDate   DateTime?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company ShippingCompany @relation(fields: [companyId], references: [id])

  @@map("shipping_info")
}

// ==================== FAVORITES & RECENTLY VIEWED ====================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("recently_viewed")
}

// ==================== CMS ====================

model Banner {
  id         String    @id @default(cuid())
  title      String?
  subtitle   String?
  image      String
  mediaType  String    @default("image") // image | video
  buttonText String?
  buttonLink String?
  duration   Int       @default(5) // saniye - otomatik kayma süresi
  startDate  DateTime?
  endDate    DateTime?
  sortOrder  Int       @default(0)
  status     Boolean   @default(true)
  position   String    @default("homepage")

  @@index([status, position])
  @@index([sortOrder])
  @@map("banners")
}

model Page {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  content     String  @db.LongText
  seoTitle    String?
  seoDesc     String? @db.Text
  status      Boolean @default(true)

  @@map("pages")
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
  status    Boolean @default(true)

  @@map("faqs")
}

model ContactForm {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_forms")
}

// ==================== SETTINGS ====================

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  group String @default("general")

  @@index([group])
  @@map("settings")
}

model ThemeSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("color")

  @@map("theme_settings")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rate      Decimal  @db.Decimal(10, 4)
  updatedAt DateTime @default(now())

  @@map("exchange_rates")
}

model EmailTemplate {
  id        String @id @default(cuid())
  name      String @unique
  subject   String
  content   String @db.LongText
  variables String? @db.Text

  @@map("email_templates")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==================== COUPON ====================

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  type            CouponType  @default(PERCENTAGE)
  value           Decimal     @db.Decimal(10, 2)
  minOrderAmount  Decimal?    @db.Decimal(10, 2)
  maxUsageCount   Int?
  usedCount       Int         @default(0)
  isActive        Boolean     @default(true)
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ==================== STOCK ALERT ====================

model StockAlert {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  email      String
  isNotified Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
  @@index([isNotified])
  @@index([email])
  @@map("stock_alerts")
}
